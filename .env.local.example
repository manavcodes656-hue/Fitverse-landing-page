# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret. Server-only, bypasses RLS. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend ──────────────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified sender. onboarding@resend.dev works immediately but can
# only deliver to the email that owns your Resend account.
RESEND_FROM_EMAIL=FitVerse <onboarding@resend.dev>

# ── Misc ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Upstash Redis (rate limiting) ───────────────────────────────────────────
# https://console.upstash.com -> create a Redis database -> REST API section.
# Required in production (requests are rejected with 503 without them).
# In development, leave blank to use an in-memory limiter.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── Cloudflare Turnstile (bot check on the waitlist form) ───────────────────
# https://dash.cloudflare.com -> Turnstile -> add a widget of type "Invisible".
# The site key is public; the secret key is server-only.
# For local testing, Cloudflare publishes dummy keys: site 1x00000000000000000000BB
# (invisible, always passes) with secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Required in production. Any long random string; salts the IP hash used for rate limiting.
IP_HASH_SALT=change-me-to-something-random
