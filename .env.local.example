# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret. Server-only, bypasses RLS. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend ──────────────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified sender. onboarding@resend.dev works immediately but can
# only deliver to the email that owns your Resend account.
RESEND_FROM_EMAIL=FitVerse <onboarding@resend.dev>

# ── Misc ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Any random string. Salts the IP hash used for rate limiting.
IP_HASH_SALT=change-me-to-something-random
